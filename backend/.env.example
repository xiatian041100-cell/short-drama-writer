# 环境变量配置
NODE_ENV=development
PORT=5000

# 数据库
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/short-drama-writer

# JWT密钥（生成命令: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"）
JWT_SECRET=your-jwt-secret-key-here

# 加密密钥（32字节十六进制字符串，生成命令: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"）
ENCRYPTION_KEY=your-32-byte-encryption-key-here

# 前端URL
FRONTEND_URL=http://localhost:3000

# AI API密钥（支持多个模型）
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-your-anthropic-key

# ============================================
# 支付配置（新商业模式必需）
# ============================================

# Stripe 配置
# 在 https://dashboard.stripe.com/apikeys 获取
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Stripe 价格ID（在Stripe Dashboard创建产品后获取）
# 标准版 - 月付
STRIPE_PRICE_STANDARD_MONTH=price_xxxxxxxxxxxxxxxx
# 标准版 - 年付（建议设置20%折扣）
STRIPE_PRICE_STANDARD_YEAR=price_xxxxxxxxxxxxxxxx
# 专业版 - 月付
STRIPE_PRICE_PRO_MONTH=price_xxxxxxxxxxxxxxxx
# 专业版 - 年付（建议设置33%折扣）
STRIPE_PRICE_PRO_YEAR=price_xxxxxxxxxxxxxxxx

# 支付宝配置（可选，如需接入支付宝）
# ALIPAY_APP_ID=your_alipay_app_id
# ALIPAY_PRIVATE_KEY=your_alipay_private_key
# ALIPAY_PUBLIC_KEY=alipay_public_key
# ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do

# 邮件服务配置（可选，用于发送通知）
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASS=your-email-password
# EMAIL_FROM=noreply@yourdomain.com

# Redis配置（可选，用于缓存和会话）
# REDIS_URL=redis://localhost:6379
